{
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm --prefix frontend run dev --",
    "build": "npm run build:frontend && npm run build:backend",
    "lint": "npm run lint:frontend && npm run lint:backend && npm run lint:tools",
    "test": "npm run test:frontend && npm run test:backend",
    "test:watch": "npm --prefix frontend run test:watch --",
    "test:e2e": "npm --prefix frontend run test:e2e --",
    "preview": "npm --prefix frontend run preview --",
    "audit:deps": "npm audit --prefix frontend --audit-level=moderate && npm audit --prefix backend --audit-level=moderate",
    "audit:prod": "npm audit --prefix frontend --omit=dev --audit-level=moderate && npm audit --prefix backend --omit=dev --audit-level=moderate",
    "install:clean": "npm ci --prefix frontend && npm ci --prefix backend",
    "dev:api": "npm --prefix backend run dev",
    "start:api": "npm --prefix backend start",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test:integration": "npm --prefix backend run test:integration",
    "db:migrate": "npm --prefix backend run migrate",
    "db:status": "npm --prefix backend run migrate:status",
    "test:auth": "npm --prefix frontend run test:auth",
    "admin:bootstrap": "npm --prefix backend run admin:bootstrap",
    "demo:prepare": "node scripts/demo.mjs prepare",
    "demo:up": "node scripts/demo.mjs up",
    "demo:down": "node scripts/demo.mjs down",
    "demo:reset": "node scripts/demo.mjs reset",
    "demo:access": "node scripts/demo.mjs access",
    "demo:backup": "node scripts/demo.mjs backup",
    "demo:restore": "node scripts/demo.mjs restore",
    "demo:status": "node scripts/demo.mjs status",
    "demo:verify": "node scripts/demo-verify.mjs",
    "evidence:academic": "npm run test:auth -- --grep ACADEMICO",
    "lint:tools": "node --check scripts/demo.mjs && node --check scripts/demo-verify.mjs && node --check scripts/academic-diagrams.mjs",
    "diagrams:academic": "node scripts/academic-diagrams.mjs"
  }
}
