# Copie para backend/.env, ignorado pelo Git. Não utilize credenciais reais neste exemplo.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wikichem
DB_USER=wikichem_app
DB_PASSWORD=
DB_POOL_SIZE=10
DB_TIMEOUT_MS=5000
# Em produção, TLS verificado é obrigatório. CA opcional usa as raízes do sistema.
DB_TLS=false
DB_TLS_CA_FILE=
# Usuário operacional distinto com DDL. Utilizado somente pelo comando migrate.
MIGRATION_DB_USER=wikichem_migrator
MIGRATION_DB_PASSWORD=
# Testes de integração exigem NODE_ENV=test, DB_NAME=wikichem_test_<sufixo>
# e MYSQL_TEST_ALLOW=true. Não apontar a bancos com dados de aplicação.

# Origem exata do navegador: deve coincidir com o endereço utilizado no Vite.
APP_ORIGIN=http://localhost:5173
SESSION_ABSOLUTE_SECONDS=28800
SESSION_IDLE_SECONDS=1800
AUTH_RATE_LIMIT_MAX=10
# Demonstração sem cobrança: prazo em segundos (5–3600) e mutações/minuto/usuário.
CHECKOUT_TTL_SECONDS=900
CHECKOUT_RATE_LIMIT_MAX=60
# Bootstrap exige terminal, responsável autorizado e conta operacional sem DDL.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_DB_USER=
ADMIN_DB_PASSWORD=
